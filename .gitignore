/.fixture-auth-reset.mjs
/.qa.mjs
/.devserver.log
/.playwright-cli/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma
src/generated/

# prisma init agent-skills (regenerated by CLI, not app code)
.claude/
.windsurf/
.agents/
skills-lock.json
