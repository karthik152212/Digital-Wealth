# Digital Wealth Vault — environment template
# Copy to .env and replace placeholders. NEVER commit real secrets.
# This file contains placeholders only.

# --- Database (Docker Compose) ---
DATABASE_URL="postgresql://vault:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:5432/digital_wealth_vault?schema=public"
POSTGRES_USER="vault"
POSTGRES_PASSWORD="CHANGE_ME_LOCAL_PASSWORD"
POSTGRES_DB="digital_wealth_vault"

# --- Better Auth (Slice 3) ---
# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth (optional — button hidden when empty) ---
# Manual setup: https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Web application)
# 2. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 3. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Simulation (validated later via Zod in src/lib/env.ts) ---
# Inactivity threshold before a vault is flagged for check-in (days)
INACTIVITY_THRESHOLD_DAYS="30"
# Nominee response/grace window once a request is eligible (days)
CLAIM_GRACE_PERIOD_DAYS="3"
# Simulated clock offset bootstrap (ms). Dev panel stores its own file at runtime.
SIM_CLOCK_OFFSET_MS="0"
# Dev-only accelerated clock controls (must be false in production)
ENABLE_DEV_CLOCK="true"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email delivery for verification emails ---
# No provider is currently configured: local development falls back to
# printing the verification link to the `next dev` server console
# (disabled in production, which fails loudly instead).
# To enable real inbox delivery, create an API key at https://resend.com and set:
RESEND_API_KEY=""
# Sender address (must be verified with the provider), e.g.
# "Digital Wealth Vault <onboarding@resend.dev>"
EMAIL_FROM=""

# --- Verification throttling (server-enforced; shared DB store) ---
# Seconds one email must wait between verification sends.
VERIFICATION_RESEND_COOLDOWN_SECONDS="60"
# Per-IP window for resends (applies to /send-verification-email and
# /api/auth/resend-verification; stored in the RateLimit table).
VERIFICATION_RESEND_IP_WINDOW_SECONDS="60"
VERIFICATION_RESEND_IP_MAX="6"
# Per-IP window for verification-link attempts (/verify-email).
VERIFICATION_ATTEMPTS_IP_WINDOW_SECONDS="60"
VERIFICATION_ATTEMPTS_IP_MAX="10"
